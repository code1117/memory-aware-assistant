# Copy this file to .env and fill in your key locally. Never commit .env.
OPENAI_API_KEY=

# Change this setting to use another compatible model available to your account.
OPENAI_MODEL=gpt-4.1-mini

# Local Neo4j connection settings used by the Python application.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_DATABASE=neo4j

# Choose a new password (at least 8 characters) in your private .env file.
# Docker uses this only to initialize an empty database. Changing it later in
# .env does not change the password already saved inside an existing database.
NEO4J_PASSWORD=
